# =============================================================================
# .evyasys/.env  —  PROJECT-LEVEL secrets and overrides
# =============================================================================
# This file lives INSIDE each project's git repo at: <your-project>/.evyasys/.env
#
# Copy this template:
#     cp .evyasys/.env.example .evyasys/.env
#
# Then add `.evyasys/.env` to .gitignore so secrets stay out of git, OR keep
# only non-secret values here (most teams keep the Teams webhook in git since
# it's a channel webhook, not a credential).
# =============================================================================

# --- Microsoft Teams ---------------------------------------------------------
# Channel-specific incoming webhook URL. Different projects use different
# channels — paste this project's webhook below. (Same URL for everyone on the
# team; this is the channel address, not a per-user token.)
TEAMS_WEBHOOK=

# --- Mode -------------------------------------------------------------------
# Default is live. Set to 1 to preview every external call without sending it.
# EVYASYS_DRY_RUN=0

# --- Azure DevOps (project-level overrides; normally live in project.yaml) ---
# Uncomment only if you'd rather keep these here than in project.yaml.
# AZURE_ORG=
# AZURE_PROJECT=

# --- Per-user PAT (DO NOT put it here for teams) -----------------------------
# Each teammate's PAT lives at ~/.evyasys/credentials (set by scripts/login.sh).
# AZURE_PAT=
