# Evyasys env overrides — only needed for CI / advanced use.
# In normal operation:
#   - Project settings live in .evyasys/project.yaml inside each project repo.
#   - Personal Access Token lives in ~/.evyasys/credentials (run scripts/login.sh once).
# This file is not loaded automatically; use it only if you prefer env vars over the
# layered config (e.g. in CI). Copy to .env and source it manually if you want.

# Optional: 1 = dry-run preview, 0 = live (default).
# EVYASYS_DRY_RUN=0

# Optional: where stories are written (defaults to your shell's cwd).
# EVYASYS_REPO_ROOT=/path/to/your/project

# Optional: override Azure DevOps target (normally read from .evyasys/project.yaml).
# AZURE_ORG=
# AZURE_PROJECT=

# Optional: override PAT (normally read from ~/.evyasys/credentials).
# AZURE_PAT=

# Optional: override Teams webhook (normally read from .evyasys/project.yaml).
# TEAMS_WEBHOOK=
